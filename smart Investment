<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>SmartInvestment Admin</title><link rel="stylesheet" href="/src/styles.css"></head><body><div id="app"></div><script type="module" src="/src/main.js"></script></body></html>

{
  "name": "smartinvestment-admin",
  "version": "1.0.0",
  "private": true,
  "scripts": { "dev": "vite --host 0.0.0.0 --port 5174", "build": "vite build", "preview": "vite preview --host 0.0.0.0 --port 5174" },
  "devDependencies": { "vite": "^7.1.7" }
}

VITE_API_URL=http://localhost:4000/api

const API=import.meta.env.VITE_API_URL||'http://localhost:4000/api';
const state={token:localStorage.getItem('si_token'),user:null,page:'dashboard',plans:[],settings:null};
const $=s=>document.querySelector(s);const money=n=>'PKR '+Number(n||0).toLocaleString('en-PK',{minimumFractionDigits:2,maximumFractionDigits:2});
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function api(path,opt={}){const headers={...(opt.body instanceof FormData?{}:{'Content-Type':'application/json'}),...(opt.headers||{})};if(state.token)headers.Authorization='Bearer '+state.token;const r=await fetch(API+path,{...opt,headers});const d=await r.json().catch(()=>({}));if(!r.ok)throw Error(d.error||'Request failed');return d}
function toast(msg){let t=$('#toast');if(!t){t=document.createElement('div');t.id='toast';document.body.appendChild(t)}t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2800)}
function shell(){document.body.innerHTML=`<div class="site"><header class="top"><div class="brand"><span class="logo">S</span><div><b>SmartInvestment</b><small>Secure wealth platform</small></div></div><div class="top-actions"><span id="userName"></span><button class="ghost" id="logout">Logout</button></div></header><div class="mobile-nav"><button data-page="dashboard">Home</button><button data-page="plans">Plans</button><button data-page="deposit">Deposit</button><button data-page="withdraw">Withdraw</button></div><div class="body"><aside class="side"><button data-page="dashboard">⌂ <span>Dashboard</span></button><button data-page="plans">◈ <span>Investment Plans</span></button><button data-page="deposit">↓ <span>Deposit</span></button><button data-page="investments">◉ <span>My Investments</span></button><button data-page="withdraw">↑ <span>Withdraw</span></button><button data-page="transactions">▤ <span>Transactions</span></button><button data-page="referrals">♧ <span>Referrals</span></button><button data-page="profile">◎ <span>Profile</span></button></aside><main id="content"></main></div></div><div id="toast"></div>`;document.querySelectorAll('[data-page]').forEach(b=>b.onclick=()=>go(b.dataset.page));$('#logout').onclick=()=>{localStorage.removeItem('si_token');location.reload()}}
function authView(){document.body.innerHTML=`<div class="auth-wrap"><div class="auth-card"><div class="brand big"><span class="logo">S</span><div><b>SmartInvestment</b><small>Secure investment platform</small></div></div><div class="tabs"><button id="loginTab" class="active">Login</button><button id="signupTab">Create account</button></div><form id="authForm"></form><div id="authMsg" class="form-msg"></div></div></div>`;let mode='login';const render=()=>{$('#authForm').innerHTML=mode==='login'?`<label>Username</label><input name="username" required minlength="3"><label>Password</label><input name="password" type="password" required><button class="primary wide">Login</button>`:`<label>Username</label><input name="username" required minlength="3"><label>Password</label><input name="password" type="password" required minlength="6"><label>Referral code <span class="muted">optional</span></label><input name="referralCode"><button class="primary wide">Create account</button>`};render();$('#loginTab').onclick=()=>{mode='login';$('#loginTab').classList.add('active');$('#signupTab').classList.remove('active');render()};$('#signupTab').onclick=()=>{mode='signup';$('#signupTab').classList.add('active');$('#loginTab').classList.remove('active');render()};$('#authForm').onsubmit=async e=>{e.preventDefault();const fd=new FormData(e.target);const body=Object.fromEntries(fd);try{const d=await api(mode==='login'?'/auth/login':'/auth/signup',{method:'POST',body:JSON.stringify(body)});state.token=d.token;localStorage.setItem('si_token',d.token);start()}catch(err){$('#authMsg').textContent=err.message}}}
async function start(){try{state.user=await api('/profile');shell();await load();go('dashboard')}catch{localStorage.removeItem('si_token');state.token=null;authView()}}
async function load(){[state.plans,state.settings]=await Promise.all([api('/plans'),api('/settings/public')]);$('#userName').textContent=state.user.username}
function go(p){state.page=p;render();document.querySelectorAll('[data-page]').forEach(x=>x.classList.toggle('active',x.dataset.page===p))}
function stat(title,value,icon){return `<div class="stat"><span class="stat-icon">${icon}</span><small>${title}</small><b>${value}</b></div>`}
async function render(){if(!state.user)return;const c=$('#content');try{if(state.page==='dashboard'){const [inv,tx]=await Promise.all([api('/investments'),api('/transactions')]);c.innerHTML=`<div class="page-head"><div><h1>Welcome, ${esc(state.user.username)}</h1><p>Manage your investments and account from one place.</p></div><button class="primary" onclick="window.__go('plans')">Explore Plans</button></div><div class="stats">${stat('Available Balance',money(state.user.balance),'◈')}${stat('Active Investments',inv.filter(x=>x.status==='active').length,'◉')}${stat('Referral Earnings',money(state.user.referral_earnings),'♧')}${stat('Transactions',tx.length,'▤')}</div><div class="grid2"><section class="panel"><div class="panel-head"><h3>Portfolio Overview</h3><span class="badge green">Live</span></div><div class="chart"><div class="bars">${[42,58,35,70,55,84,65,92,78,96].map((h,i)=>`<i style="height:${h}%" title="${i+1}"></i>`).join('')}</div><div class="chart-line"></div></div></section><section class="panel"><div class="panel-head"><h3>Available Plans</h3><button class="link" onclick="window.__go('plans')">View all</button></div>${state.plans.slice(0,4).map(p=>`<div class="row-item"><span><b>${esc(p.name)}</b><small>${p.duration_days} days · ${p.daily_rate}% daily</small></span><strong>${money(p.amount)}</strong></div>`).join('')}</section></div><section class="panel"><div class="panel-head"><h3>Recent Transactions</h3><button class="link" onclick="window.__go('transactions')">View all</button></div>${tx.slice(0,6).map(t=>`<div class="row-item"><span><b>${esc(t.type)}</b><small>${new Date(t.created_at).toLocaleString()}</small></span><strong>${money(t.amount)}</strong><span class="badge ${t.status}">${t.status}</span></div>`).join('')||'<div class="empty">No transactions yet.</div>'}</section>`}
else if(state.page==='plans'){c.innerHTML=`<div class="page-head"><div><h1>Investment Plans</h1><p>Choose from active plans configured by the platform.</p></div></div><div class="plan-grid">${state.plans.map(p=>`<article class="plan-card"><div class="plan-top"><span class="badge blue">ACTIVE</span><h3>${esc(p.name)}</h3></div><div class="plan-amount">${money(p.amount)}</div><div class="plan-meta"><span>Daily rate <b>${p.daily_rate}%</b></span><span>Validity <b>${p.duration_days} days</b></span></div><button class="primary wide" onclick="window.__invest(${p.id})">Invest now</button></article>`).join('')}</div>`}
else if(state.page==='deposit'){c.innerHTML=`<div class="page-head"><div><h1>Deposit</h1><p>Submit your payment for admin verification.</p></div></div><div class="grid2"><section class="panel"><h3>Payment Methods</h3>${state.settings.methods.map(m=>m.enabled?`<div class="payment-method"><b>${esc(m.name)}</b><span>${esc(m.account_name)}</span><strong>${esc(m.account_number)}</strong><small>${esc(m.instructions||'Send payment and keep your transaction reference.')}</small></div>`:'').join('')}</section><section class="panel"><h3>Deposit Request</h3><form id="depositForm"><label>Investment plan</label><select name="planId">${state.plans.map(p=>`<option value="${p.id}">${esc(p.name)} — ${money(p.amount)}</option>`).join('')}</select><label>Transaction ID / Reference</label><input name="transactionId" required><label>Payment screenshot <span class="muted">optional</span></label><input name="paymentScreenshot" type="file" accept="image/*"><button class="primary wide">Submit for verification</button><div id="formMsg" class="form-msg"></div></form></section></div>`;$('#depositForm').onsubmit=async e=>{e.preventDefault();try{const d=await api('/deposits',{method:'POST',body:new FormData(e.target)});toast(d.message);go('transactions')}catch(err){$('#formMsg').textContent=err.message}}}
else if(state.page==='investments'){const inv=await api('/investments');c.innerHTML=`<div class="page-head"><div><h1>My Investments</h1><p>Your existing investments retain their original terms.</p></div></div><section class="panel">${inv.map(x=>`<div class="investment"><div><b>${esc(x.plan_name)}</b><small>${new Date(x.start_at).toLocaleDateString()} → ${new Date(x.end_at).toLocaleDateString()}</small></div><strong>${money(x.amount)}</strong><span>${x.daily_rate}% / day</span><span class="badge ${x.status}">${x.status}</span></div>`).join('')||'<div class="empty">No investments yet. Deposit and invest to get started.</div>'}</section>`}
else if(state.page==='withdraw'){c.innerHTML=`<div class="page-head"><div><h1>Withdraw</h1><p>Request withdrawal from your available balance.</p></div></div><section class="panel form-panel"><div class="available">Available balance <b>${money(state.user.balance)}</b></div><form id="withdrawForm"><label>Amount</label><input name="amount" type="number" min="1" step="0.01" required><label>Payment method</label><select name="method"><option>EasyPaisa</option><option>JazzCash</option><option>Bank Transfer</option></select><label>Account details</label><textarea name="account" rows="4" placeholder="Account name and number / bank details" required></textarea><button class="primary wide">Submit withdrawal</button><div id="formMsg" class="form-msg"></div></form></section>`;$('#withdrawForm').onsubmit=async e=>{e.preventDefault();try{const d=await api('/withdrawals',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});toast(d.message);await refreshUser();go('transactions')}catch(err){$('#formMsg').textContent=err.message}}}
else if(state.page==='transactions'){const tx=await api('/transactions');c.innerHTML=`<div class="page-head"><div><h1>Transactions</h1><p>Complete account ledger.</p></div></div><section class="panel table-wrap"><table><thead><tr><th>Type</th><th>Amount</th><th>Reference</th><th>Status</th><th>Date</th></tr></thead><tbody>${tx.map(t=>`<tr><td>${esc(t.type)}</td><td>${money(t.amount)}</td><td>${esc(t.reference||'—')}</td><td><span class="badge ${t.status}">${t.status}</span></td><td>${new Date(t.created_at).toLocaleString()}</td></tr>`).join('')||'<tr><td colspan="5">No transactions.</td></tr>'}</tbody></table></section>`}
else if(state.page==='referrals'){const r=await api('/referrals');c.innerHTML=`<div class="page-head"><div><h1>Referrals</h1><p>Invite users with your referral code.</p></div></div><div class="stats">${stat('Referral Code',`<span class="code">${esc(r.code)}</span>`,'♧')}${stat('Total Referrals',r.total,'◎')}${stat('Referral Earnings',money(r.earnings),'$')}</div><section class="panel"><h3>Referred Users</h3>${r.users.map(u=>`<div class="row-item"><span><b>${esc(u.username)}</b><small>${new Date(u.created_at).toLocaleDateString()}</small></span><span class="badge ${u.reward_status}">${u.reward_status}</span></div>`).join('')||'<div class="empty">No referrals yet.</div>'}</section>`}
else if(state.page==='profile'){c.innerHTML=`<div class="page-head"><div><h1>Profile</h1><p>Account and security information.</p></div></div><section class="panel profile"><div class="avatar">${esc(state.user.username[0].toUpperCase())}</div><h2>${esc(state.user.username)}</h2><p>Joined ${new Date(state.user.created_at).toLocaleDateString()}</p><div class="profile-grid"><div><small>Referral code</small><b>${esc(state.user.referral_code)}</b></div><div><small>Status</small><b>${esc(state.user.status)}</b></div></div><button class="outline" id="changePass">Change password</button></section>`;$('#changePass').onclick=async()=>{const current=prompt('Current password');if(current===null)return;const next=prompt('New password (minimum 6 characters)');if(!next)return;try{await api('/auth/change-password',{method:'POST',body:JSON.stringify({currentPassword:current,newPassword:next})});toast('Password changed')}catch(e){toast(e.message)}}}}
catch(e){c.innerHTML=`<section class="panel error">${esc(e.message)}</section>`}}
async function refreshUser(){state.user=await api('/profile');$('#userName').textContent=state.user.username}
window.__go=go;window.__invest=async id=>{try{const d=await api('/investments',{method:'POST',body:JSON.stringify({planId:id})});toast(d.message);await refreshUser();go('investments')}catch(e){toast(e.message)}};
