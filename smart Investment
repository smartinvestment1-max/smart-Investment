app.post('/api/admin/deposits/:id/approve',adminOnly,async(req,res)=>{const c=await pool.getConnection();try{await c.beginTransaction();const [d]=await c.query('SELECT * FROM deposits WHERE id=? FOR UPDATE',[req.params.id]);if(!d.length||d[0].status!=='pending'){await c.rollback();return bad(res,'Deposit is no longer pending.')}const dep=d[0];await c.query('UPDATE deposits SET status="approved",reviewed_by=?,reviewed_at=NOW() WHERE id=?',[req.auth.id,dep.id]);const [tx]=await c.query('SELECT id FROM transactions WHERE user_id=? AND type="deposit" AND reference=? LIMIT 1',[dep.user_id,'DEP-'+dep.id]);await c.query('UPDATE users SET balance=balance+? WHERE id=?',[dep.amount,dep.user_id]);if(tx.length)await c.query('UPDATE transactions SET status="approved",amount=?,description=? WHERE id=?',[dep.amount,'Deposit approved and credited',tx[0].id]);else await c.query('INSERT INTO transactions(user_id,type,amount,reference,status,description) VALUES(?,?,?,?,?,?)',[dep.user_id,'deposit',dep.amount,'DEP-'+dep.id,'approved','Deposit approved and credited']);await c.query('INSERT INTO notifications(user_id,title,message) VALUES(?,?,?)',[dep.user_id,'Deposit approved',`Your deposit of PKR ${Number(dep.amount).toLocaleString()} has been approved.`]);const rate=Number(await setting('referral_rate','5'));if(rate>0){const [rf]=await c.query('SELECT * FROM referrals WHERE referred_user_id=? AND status="valid"',[dep.user_id]);if(rf.length){const reward=Number(dep.amount)*rate/100;await c.query('INSERT INTO referral_rewards(referral_id,referrer_user_id,referred_user_id,source_deposit_id,amount,status,paid_at) VALUES(?,?,?,?,?,"paid",NOW())',[rf[0].id,rf[0].referrer_user_id,dep.user_id,dep.id,reward]);await c.query('UPDATE users SET balance=balance+?,referral_earnings=referral_earnings+? WHERE id=?',[reward,reward,rf[0].referrer_user_id]);await c.query('INSERT INTO transactions(user_id,type,amount,reference,status,description) VALUES(?,?,?,?,?,?)',[rf[0].referrer_user_id,'referral_reward',reward,ref('REF'),'completed','Referral reward for approved deposit']);}}await c.commit();await audit(req.auth.id,'APPROVE_DEPOSIT','deposit',dep.id,{amount:dep.amount,user_id:dep.user_id});res.json({message:'Deposit approved and credited.'})}catch(e){await c.rollback();res.status(500).json({error:e.message})}finally{c.release()}});
